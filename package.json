{
  "name": "az-chatbot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:bot": "bun run --cwd apps/bot dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev": "bun run dev:api & bun run dev:bot & bun run dev:dashboard",
    "type-check": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}