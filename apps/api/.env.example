# API
PORT=3001

# Database
DATABASE_HOST=jdbc:postgresql://localhost:5432/chatbot_db
DATABASE_PORT=5432
DATABASE_USER=chatbot
DATABASE_PASSWORD=chatbot_dev
DATABASE_NAME=chatbot_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin credentials (MVP — single user)
ADMIN_EMAIL=admin@renault.com
ADMIN_PASSWORD=admin123

# Bot API Key (used by BuilderBot to authenticate requests)
BOT_API_KEY=bot_api_key_change_in_production

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_dev_key
EVOLUTION_INSTANCE=renault-bot
